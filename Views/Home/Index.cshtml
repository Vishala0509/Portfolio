
@{
    ViewData["Title"] = "Home";
}

<section id="about" class="section">
    @await Html.PartialAsync("About")
</section>

<section id="skills" class="section">
    @await Html.PartialAsync("Skills")
</section>

<section id="education" class="section">
    @await Html.PartialAsync("Education")
</section>

<section id="experience" class="section">
    @await Html.PartialAsync("Experience")
</section>

<section id="projects" class="section">
    @await Html.PartialAsync("Projects")
</section>

<section id="certifications" class="section">
    @await Html.PartialAsync("Certifications")
</section>

<section id="contact" class="section">
    @await Html.PartialAsync("Contact")
</section>

<button id="scrollToTopBtn" title="Go to top"><i class="bi bi-arrow-up-circle"></i></button>

<script>
    // Get the button
    var mybutton = document.getElementById("scrollToTopBtn");

    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            mybutton.style.display = "block";
        } else {
            mybutton.style.display = "none";
        }
    };

    // When the user clicks on the button, scroll to the top of the document
    mybutton.onclick = function () {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
    }
</script>